{
  "expo": {
    "name": "Student Portal",
    "slug": "authenticated-student-portal",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",

    "scheme": "studentportal",

    "splash": {
      "backgroundColor": "#0F172A"
    },

    "assetBundlePatterns": [
      "**/*"
    ],

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      }
    },

    "web": {
      "bundler": "metro"
    },

    "plugins": [
      "expo-secure-store"
    ]
  }
}